# Copiá este archivo como .env (cp .env.example .env) y completá CADA variable.
# docker compose corta con un mensaje claro si falta alguna. .env está en .gitignore: nunca se versiona.
# Los valores sugeridos son solo para desarrollo local; no uses secretos reales acá.

# --- Base PostgreSQL (la crea el propio compose) ---
# URL JDBC. Sugerido local: jdbc:postgresql://db:5432/transito
DB_URL=
# Usuario de la base. Sugerido local: transito
DB_USER=
# Contraseña de la base (inventá una para local).
DB_PASSWORD=

# --- Backend ---
# Secreto para firmar los JWT: cualquier texto de 32 caracteres o más (solo local).
JWT_SECRET=
# Orígenes CORS permitidos, separados por coma. Sugerido: http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=
# false = login con el validador local (ciudadano1, inspector1, admin1).
# true  = login contra el mock de M1 (cuentas *.mock@example.com, ver README).
USERS_REST_ENABLED=
# Contraseñas de los usuarios de prueba del validador local (solo desarrollo; NO son las de producción).
# Si dejás una vacía, ese usuario queda deshabilitado (login 401) y el backend lo avisa en el log al arrancar.
STUB_PASSWORD_CIUDADANO1=dev-ciudadano1-local
STUB_PASSWORD_INSPECTOR1=dev-inspector1-local
STUB_PASSWORD_ADMIN1=dev-admin1-local

# --- Broker RabbitMQ local (el usuario del broker es siempre module_transito) ---
# Contraseña del usuario module_transito del RabbitMQ local (inventá una para local).
CORE_RABBITMQ_PASSWORD=
# "Secret de máquina" ficticio para el mock de Core: cualquier texto no vacío (no es el real).
CORE_MODULE_SECRET=

# --- IA (opcional; apagada si no se define) ---
# Para la demo local contra el mock del proveedor (WireMock, sin clave real): AI_ENABLED=true y GROQ_API_KEY con cualquier texto.
# La clave real de Groq NUNCA va en este archivo.
AI_ENABLED=
GROQ_API_KEY=
