{
  "mappings": [
    {
      "name": "M1 login - ciudadano ficticio",
      "priority": 1,
      "request": {
        "method": "POST", "url": "/auth/usuario/login",
        "bodyPatterns": [
          { "matchesJsonPath": "$[?(@.gmail == 'ciudadano.mock@example.com')]" },
          { "matchesJsonPath": "$[?(@.password == 'Ciudadano123!')]" }
        ]
      },
      "response": {
        "status": 200, "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "auth": true,
          "actorId": "11111111-1111-4111-8111-111111111111",
          "actorType": "CIUDADANO",
          "role": "CIUDADANO",
          "citizenId": "22222222-2222-4222-8222-222222222222",
          "dni": "30777888"
        }
      }
    },
    {
      "name": "M1 login - empleado ficticio",
      "priority": 1,
      "request": {
        "method": "POST", "url": "/auth/usuario/login",
        "bodyPatterns": [
          { "matchesJsonPath": "$[?(@.gmail == 'empleado.mock@example.com')]" },
          { "matchesJsonPath": "$[?(@.password == 'Empleado123!')]" }
        ]
      },
      "response": {
        "status": 200, "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "auth": true,
          "actorId": "33333333-3333-4333-8333-333333333333",
          "actorType": "EMPLEADO",
          "role": "MESA_ENTRADAS"
        }
      }
    },
    {
      "name": "M1 login - credenciales inválidas",
      "priority": 10,
      "request": { "method": "POST", "url": "/auth/usuario/login" },
      "response": {
        "status": 401, "headers": { "Content-Type": "application/json" },
        "jsonBody": { "auth": false, "message": "Credenciales inválidas" }
      }
    }
  ]
}
